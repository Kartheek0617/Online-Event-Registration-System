# Environment Configuration Template for Online Event Registration System
# Duplicate this file as .env for local configuration

# Application
APP_NAME="Online Event Registration System"
ENVIRONMENT="development"
DEBUG="false"
API_PREFIX="/api"

# Security & Secrets (Generate strong secret: openssl rand -hex 32)
SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="120"
COOKIE_SECURE="false"  # Set to true in production over HTTPS
COOKIE_SAMESITE="lax"

# Database Configuration (PostgreSQL default, falls back to SQLite if unreachable in dev/test)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/event_registration_db"
DB_POOL_SIZE="10"
DB_MAX_OVERFLOW="20"

# CORS Configuration (Comma-separated allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Rate Limiting
RATE_LIMIT_LOGIN_MAX_ATTEMPTS="5"
RATE_LIMIT_LOGIN_WINDOW_SECONDS="60"
RATE_LIMIT_REGISTER_MAX_ATTEMPTS="10"
RATE_LIMIT_REGISTER_WINDOW_SECONDS="60"
